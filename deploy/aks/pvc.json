{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "mtn-whatsapp-qa-reports",
    "namespace": "mtn-whatsapp-qa"
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "storageClassName": "managed-csi",
    "resources": {
      "requests": {
        "storage": "20Gi"
      }
    }
  }
}
