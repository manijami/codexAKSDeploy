# Allowlist: exclude private configuration, captures, virtualenvs and local PDFs.
**
!Dockerfile
!.dockerignore
!requirements*.txt
!run.py
!*.command
!qa/
!qa/**
!scripts/
!scripts/**
!suites/
!suites/**
!datasets/
!datasets/**
!sources/
!sources/**
!config/
!config/settings.json
!config/payload.template.json
!deploy/
!deploy/aks/
!deploy/aks/**
**/__pycache__/**
**/*.pyc
**/.DS_Store
**/*.private.*
**/*.env
**/secrets.env
**/local.json
