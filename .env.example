# Literal KEY=value values. Do not source this file in the shell.
# Use python scripts/configure.py or python scripts/import_request.py PATH.
MORPHEUS_BASE_URL=https://qa-serviceauth.mtn.co.za
MORPHEUS_API_KEY=
MORPHEUS_COOKIE=
MORPHEUS_HEADERS_JSON={}
# Preserve the supplied POSTPAID/prepaid endpoint combination until confirmed.
QA_SUBSCRIBER_TYPE_A=POSTPAID
QA_SUBSCRIBER_TYPE_B=POSTPAID
QA_MSISDN_A=
QA_MSISDN_B=
QA_CONVERSATION_ID_A=
QA_CONVERSATION_ID_B=
# Provided mode consumes a distinct ID per case/session slot in a run.
QA_CONVERSATION_IDS_A_JSON=[]
QA_CONVERSATION_IDS_B_JSON=[]
# Different numbers alone do not establish different authenticated principals.
QA_HEADERS_A_JSON={}
QA_HEADERS_B_JSON={}
# Optional session-specific query keys if gateway identity is carried there.
QA_API_KEY_A=
QA_API_KEY_B=
